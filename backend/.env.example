# ==============================================================================
# LocalCraft Backend Environment Configuration Template
# ==============================================================================

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=localcraft_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Django Core
DJANGO_SECRET_KEY=localcraft-insecure-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone & Localization
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh
DJANGO_LANGUAGE_CODE=vi

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cache Configuration (Redis via Docker Desktop or FileBasedCache)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
REDIS_URL=redis://127.0.0.1:6379/1

# ==============================================================================
# Email Configuration (Gửi mã xác thực OTP qua Gmail / SMTP)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=LocalCraft <no-reply@localcraft.vn>

# ==============================================================================
# Cloudinary Media Storage (Lưu trữ ảnh trên Cloudinary)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

