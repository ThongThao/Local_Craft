# ==============================================================================
# LocalCraft Backend Environment Configuration
# Copy this file to .env in the backend folder or use root .env
# ==============================================================================

# Database Configuration (MySQL cài đặt trực tiếp trên máy)
DB_ENGINE=django.db.backends.mysql
DB_NAME=localcraft_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Django Core
DJANGO_SECRET_KEY=localcraft-dev-insecure-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone & Localization
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh
DJANGO_LANGUAGE_CODE=vi

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
