# ==============================================================================
# LocalCraft Monorepo .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment Configuration
.env
.env.local
.env.*.local
*.env

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Django media & static collected & cache
media/
staticfiles/
*.sqlite3
*.log
.cache/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# IDE & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.coverage.*
*.lcov

